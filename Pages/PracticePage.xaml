<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
             xmlns:views="clr-namespace:SpeechBuddyAI.Views"
             x:Class="SpeechBuddyAI.Pages.PracticePage"
             ios:Page.UseSafeArea="True"
             Title="Practice">
    <ScrollView>
        <VerticalStackLayout Style="{StaticResource PageRootLayoutStyle}">
            <Label Text="M1 Practice Scoring" Style="{StaticResource PageTitleLabelStyle}" />
            <Label Text="Capture an attempt, compute score components, and persist the result." Style="{StaticResource SupportingTextLabelStyle}" />

            <Label Text="Target sound" Style="{StaticResource InputLabelStyle}" />
            <Entry x:Name="TargetSoundEntry" Style="{StaticResource FilledInputEntryStyle}" Placeholder="e.g., r or sh" TabIndex="0" SemanticProperties.Description="Enter target sound such as r, s, or sh" />

            <Label Text="Word position (optional)" Style="{StaticResource InputLabelStyle}" />
            <Picker x:Name="PositionPicker"
                    Title="Any position"
                    TabIndex="1"
                    SemanticProperties.Description="Select word position for generated practice words">
                <Picker.Items>
                    <x:String>Any</x:String>
                    <x:String>Initial</x:String>
                    <x:String>Medial</x:String>
                    <x:String>Final</x:String>
                </Picker.Items>
            </Picker>

            <Label Text="Attempt transcript" Style="{StaticResource InputLabelStyle}" />
                <Editor x:Name="TranscriptEditor"
                    Style="{StaticResource FilledEditorStyle}"
                    Placeholder="Type recognized transcript here"
                        TabIndex="2"
                    SemanticProperties.Description="Transcript editor for captured speech"
                    HeightRequest="144" />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button Grid.Column="0"
                    Text="Score Attempt"
                    TabIndex="3"
                    SemanticProperties.Description="Score current attempt and save results"
                    Clicked="OnScoreAttemptClicked"
                    HorizontalOptions="Fill" />
                <Button Grid.Column="1"
                    Text="Generate Practice List"
                    TabIndex="4"
                    SemanticProperties.Description="Generate practice words for the selected target"
                    Clicked="OnGeneratePracticeListClicked"
                    HorizontalOptions="Fill" />
                </Grid>

            <views:StatusBannerView x:Name="PracticeStatusBanner" Message="No attempt scored yet." />

            <Frame Style="{StaticResource CardFrameStyle}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Score Components" Style="{StaticResource SectionTitleLabelStyle}" />
                    <Label x:Name="PhonemeScoreLabel" Text="Phoneme: -" />
                    <Label x:Name="FluencyScoreLabel" Text="Fluency: -" />
                    <Label x:Name="ConsistencyScoreLabel" Text="Consistency: -" />
                    <Label x:Name="OverallScoreLabel" Text="Overall: -" FontAttributes="Bold" />
                    <Label x:Name="ProviderLabel" Text="Provider: -" />
                    <Label x:Name="ConfidenceLabel" Text="Confidence: -" />
                </VerticalStackLayout>
            </Frame>

            <Frame Style="{StaticResource CardFrameStyle}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Generated Practice Words" Style="{StaticResource SectionTitleLabelStyle}" />
                    <Label x:Name="PracticeWordsLabel" Text="No words generated yet." SemanticProperties.Description="Generated practice words for the current target" SemanticProperties.Hint="Read the generated words after choosing a target and optional position" />
                </VerticalStackLayout>
            </Frame>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
