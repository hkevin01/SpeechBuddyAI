<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
             x:Class="SpeechBuddyAI.Pages.ProgressPage"
             ios:Page.UseSafeArea="True"
             Title="Progress">
    <ScrollView>
        <VerticalStackLayout Style="{StaticResource PageRootLayoutStyle}">
            <Label Text="Progress Dashboard" Style="{StaticResource PageTitleLabelStyle}" />
            <Label x:Name="TrajectoryLabel" Text="Trajectory not available yet." Style="{StaticResource SupportingTextLabelStyle}" />

            <HorizontalStackLayout Spacing="8">
                <Entry x:Name="FilterEntry"
                       Style="{StaticResource FilledInputEntryStyle}"
                       Placeholder="Filter by target sound..."
                       TabIndex="0"
                       SemanticProperties.Description="Filter progress entries by target sound"
                       HorizontalOptions="FillAndExpand"
                       TextChanged="OnFilterTextChanged" />
                <Button Text="Clear"
                    Style="{StaticResource SecondaryButtonStyle}"
                    TabIndex="1"
                        SemanticProperties.Description="Clear target-sound filter"
                        Clicked="OnFilterClearClicked" />
            </HorizontalStackLayout>
            <Frame Style="{StaticResource CardFrameStyle}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Comparison Date Range" Style="{StaticResource SectionTitleLabelStyle}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="Start" Style="{StaticResource CaptionLabelStyle}" />
                            <DatePicker x:Name="ProgressStartDatePicker"
                                        TabIndex="2"
                                        SemanticProperties.Description="Start date for comparison range"
                                        DateSelected="OnDateRangeChanged" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="3">
                            <Label Text="End" Style="{StaticResource CaptionLabelStyle}" />
                            <DatePicker x:Name="ProgressEndDatePicker"
                                        TabIndex="3"
                                        SemanticProperties.Description="End date for comparison range"
                                        DateSelected="OnDateRangeChanged" />
                        </VerticalStackLayout>
                    </Grid>
                    <Label x:Name="DateRangeSummaryLabel" Text="Date range: -" Style="{StaticResource CaptionLabelStyle}" />
                </VerticalStackLayout>
            </Frame>

            <Frame Style="{StaticResource CardFrameStyle}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Session Comparison" Style="{StaticResource SectionTitleLabelStyle}" />
                    <Grid x:Name="SessionComparisonGrid" ColumnDefinitions="*,*" ColumnSpacing="10" RowSpacing="8">
                        <Frame x:Name="CurrentSessionCard" Grid.Column="0" Style="{StaticResource MetricCardFrameStyle}" BorderColor="#DDE7F7" BackgroundColor="#F7FAFF">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="Current Session" FontAttributes="Bold" />
                                <Label x:Name="CurrentSessionDateLabel" Text="Date: -" />
                                <Label x:Name="CurrentSessionAttemptsLabel" Text="Attempts: -" />
                                <Label x:Name="CurrentSessionOverallLabel" Text="Overall Avg: -" />
                                <Label x:Name="CurrentSessionConfidenceLabel" Text="Confidence Avg: -" />
                            </VerticalStackLayout>
                        </Frame>
                        <Frame x:Name="PreviousSessionCard" Grid.Column="1" Style="{StaticResource MetricCardFrameStyle}" BorderColor="#EADCF8" BackgroundColor="#FCF8FF">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="Previous Session" FontAttributes="Bold" />
                                <Label x:Name="PreviousSessionDateLabel" Text="Date: -" />
                                <Label x:Name="PreviousSessionAttemptsLabel" Text="Attempts: -" />
                                <Label x:Name="PreviousSessionOverallLabel" Text="Overall Avg: -" />
                                <Label x:Name="PreviousSessionConfidenceLabel" Text="Confidence Avg: -" />
                            </VerticalStackLayout>
                        </Frame>
                    </Grid>
                    <HorizontalStackLayout Spacing="14">
                        <Label x:Name="OverallDeltaLabel" Text="Overall delta: -" />
                        <Label x:Name="ConfidenceDeltaLabel" Text="Confidence delta: -" />
                    </HorizontalStackLayout>
                    <Label x:Name="ConfidenceMovementSummaryLabel" Text="Band movement: -" />
                    <Label x:Name="ComparisonNarrativeLabel" Text="Comparison narrative: -" LineBreakMode="WordWrap" />
                    <Label x:Name="NormalizationModeLabel" Text="Normalization: -" />
                    <CollectionView x:Name="SummaryBadgesCollection"
                                    SelectionMode="None"
                                    SemanticProperties.Description="Summary badges for session comparison metrics"
                                    SemanticProperties.Hint="Swipe through summary badges for current session comparison details"
                                    HeightRequest="52">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame BorderColor="{Binding BorderColor}" BackgroundColor="{Binding BackgroundColor}" Padding="8,4" CornerRadius="10">
                                    <VerticalStackLayout Spacing="1">
                                        <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="11" />
                                        <Label Text="{Binding Value}" FontSize="11" />
                                    </VerticalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    <Label Text="Target Improvements" FontAttributes="Bold" Margin="0,8,0,0" />
                    <CollectionView x:Name="TargetComparisonChips"
                                    SelectionMode="None"
                                    SemanticProperties.Description="Target improvement chips showing per-target change and confidence movement"
                                    SemanticProperties.Hint="Swipe horizontally to review each target's comparison chip"
                                    HeightRequest="60">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame BorderColor="{Binding ChipBorderColor}" BackgroundColor="{Binding ChipBackgroundColor}" Padding="8,4" CornerRadius="12">
                                    <VerticalStackLayout Spacing="1">
                                        <Label Text="{Binding TargetSound}" FontAttributes="Bold" />
                                        <Label Text="{Binding OverallDelta, StringFormat='{0:+0%;-0%;0%}'}" FontSize="12" />
                                        <Label Text="{Binding ConfidenceMovementLabel}" FontSize="10" />
                                    </VerticalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    <Label Text="Chip Legend" FontAttributes="Bold" FontSize="12" />
                    <CollectionView x:Name="ConfidenceLegendCollection"
                                    SelectionMode="None"
                                    SemanticProperties.Description="Legend for confidence comparison chip colors"
                                    SemanticProperties.Hint="Read the legend items to understand chip status colors"
                                    HeightRequest="44">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame BorderColor="{Binding BorderColor}" BackgroundColor="{Binding BackgroundColor}" Padding="8,3" CornerRadius="10">
                                    <Label Text="{Binding Title}" FontSize="11" />
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    <Label Text="Recent Session History" FontAttributes="Bold" FontSize="12" />
                    <CollectionView x:Name="SessionTimelineCollection"
                                    SelectionMode="None"
                                    SemanticProperties.Description="Recent session history timeline"
                                    SemanticProperties.Hint="Browse timeline rows to compare session-level overall and confidence trends"
                                    HeightRequest="180">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame BorderColor="#E9ECEF" BackgroundColor="#FAFAFA" Padding="8,6" Margin="0,0,0,6">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding SessionDateText}" FontAttributes="Bold" />
                                        <HorizontalStackLayout Spacing="10">
                                            <Label Text="{Binding AttemptsText}" FontSize="12" />
                                            <Label Text="{Binding OverallText}" FontSize="12" />
                                            <Label Text="{Binding ConfidenceText}" FontSize="12" />
                                        </HorizontalStackLayout>
                                        <Label Text="{Binding DeltaText}" FontSize="12" />
                                    </VerticalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Frame>

            <Frame Style="{StaticResource CardFrameStyle}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Score Trend (Recent Attempts)" Style="{StaticResource SectionTitleLabelStyle}" />
                    <HorizontalStackLayout Spacing="14">
                        <HorizontalStackLayout Spacing="4">
                            <BoxView Color="#4C8EDA" WidthRequest="14" HeightRequest="10" />
                            <Label Text="Overall" VerticalTextAlignment="Center" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="4">
                            <BoxView Color="#2F9E44" WidthRequest="14" HeightRequest="10" />
                            <Label Text="Confidence" VerticalTextAlignment="Center" />
                        </HorizontalStackLayout>
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="14">
                        <Label x:Name="ModerateThresholdLabel" Text="Moderate threshold: -" />
                        <Label x:Name="HighThresholdLabel" Text="High threshold: -" />
                    </HorizontalStackLayout>
                    <CollectionView x:Name="TrendCollection" HeightRequest="180">
                                    SemanticProperties.Description="Recent attempt score trend chart"
                                    SemanticProperties.Hint="Browse trend rows to compare overall and confidence values for recent attempts">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Padding="0,4">
                                    <Label Text="{Binding AttemptIndex, StringFormat='#{0}'}" VerticalTextAlignment="Center" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="3">
                                        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                            <Grid Grid.Column="0" WidthRequest="{OnIdiom Phone=180, Tablet=320, Desktop=260}" HorizontalOptions="Start">
                                                <BoxView Color="{StaticResource ChartOverall}"
                                                        HeightRequest="10"
                                                        WidthRequest="{Binding BarWidth}"
                                                        HorizontalOptions="Start" />
                                            </Grid>
                                            <Label Grid.Column="1"
                                                   Text="{Binding ScoreLabel}"
                                                   Margin="8,0,0,0"
                                                   VerticalTextAlignment="Center" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                            <Grid Grid.Column="0" WidthRequest="{OnIdiom Phone=180, Tablet=320, Desktop=260}" HorizontalOptions="Start">
                                                <BoxView Color="{StaticResource ThresholdModerate}"
                                                        WidthRequest="1"
                                                        HeightRequest="10"
                                                        HorizontalOptions="Start"
                                                        TranslationX="{Binding ModerateGuideOffset}" />
                                                <BoxView Color="{StaticResource ThresholdHigh}"
                                                        WidthRequest="1"
                                                        HeightRequest="10"
                                                        HorizontalOptions="Start"
                                                        TranslationX="{Binding HighGuideOffset}" />
                                                <BoxView Color="{StaticResource ChartConfidence}"
                                                        HeightRequest="10"
                                                        WidthRequest="{Binding ConfidenceBarWidth}"
                                                        HorizontalOptions="Start" />
                                            </Grid>
                                            <Label Grid.Column="1"
                                                   Text="{Binding ConfidenceLabel}"
                                                   Margin="8,0,0,0"
                                                   VerticalTextAlignment="Center" />
                                        </Grid>
                                    </VerticalStackLayout>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Frame>

            <CollectionView x:Name="ProgressCollection"
                            SemanticProperties.Description="Saved progress entries list"
                            SemanticProperties.Hint="Browse saved attempts to review detailed scoring history for each target">
                <CollectionView.EmptyView>
                    <Label Text="No attempts saved yet. Score an attempt in Practice." />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Margin="0,0,0,10" Style="{StaticResource CardFrameStyle}">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding TargetSound, StringFormat='Target: {0}'}" FontAttributes="Bold" />
                                <Label Text="{Binding Timestamp, StringFormat='When: {0:yyyy-MM-dd HH:mm}'}" />
                                <Label Text="{Binding TrialCount, StringFormat='Trial: {0}'}" />
                                <Label Text="{Binding PhonemeScore, StringFormat='Phoneme: {0:P0}'}" />
                                <Label Text="{Binding FluencyScore, StringFormat='Fluency: {0:P0}'}" />
                                <Label Text="{Binding ConsistencyScore, StringFormat='Consistency: {0:P0}'}" />
                                <Label Text="{Binding OverallScore, StringFormat='Overall: {0:P0}'}" FontAttributes="Bold" />
                                <Label Text="{Binding ConfidenceScore, StringFormat='Confidence: {0:P0}'}" />
                                <Label Text="{Binding ConfidenceBand, StringFormat='Confidence Band: {0}'}" />
                                <Label Text="{Binding ErrorPattern, StringFormat='Pattern: {0}'}" />
                                <Label Text="{Binding ScoringProvider, StringFormat='Provider: {0}'}" />
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
