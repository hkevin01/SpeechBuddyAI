<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
         xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
             x:Class="SpeechBuddyAI.Pages.NotesPage"
         ios:Page.UseSafeArea="True"
             Title="Notes">
    <ScrollView>
    <VerticalStackLayout Style="{StaticResource PageRootLayoutStyle}">
        <Label Text="Session Notes" Style="{StaticResource PageTitleLabelStyle}" />
            <Editor x:Name="RawNoteEditor" Placeholder="Type or dictate your note here..." HeightRequest="180" />

        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
        <Button Grid.Column="0"
            Text="Generate Summaries"
                SemanticProperties.Description="Generate clinician and parent summaries from current note and recent progress"
            Clicked="OnGenerateSummariesClicked" />
        <Button Grid.Column="1"
            Text="Save Note"
                SemanticProperties.Description="Save generated note and summaries to note history"
            Clicked="OnSaveNoteClicked" />
        </Grid>

            <HorizontalStackLayout x:Name="ExportFormatRow" Spacing="10" VerticalOptions="Center">
                <Label Text="Export format" VerticalOptions="Center" />
                <Picker x:Name="ExportFormatPicker"
                SemanticProperties.Description="Select export format for reports"
                        SelectedIndex="0"
                        SelectedIndexChanged="OnExportFormatChanged">
                    <Picker.Items>
                        <x:String>Plain Text (.txt)</x:String>
                        <x:String>Markdown (.md)</x:String>
                        <x:String>CSV Summary (.csv)</x:String>
                    </Picker.Items>
                </Picker>
            </HorizontalStackLayout>

            <Frame Style="{StaticResource CardFrameStyle}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Export Metadata Window" Style="{StaticResource SectionTitleLabelStyle}" />
                    <Label Text="Metadata summaries use entries from this date range." FontSize="12" TextColor="#666666" />
                    <HorizontalStackLayout Spacing="10">
                        <VerticalStackLayout>
                            <Label Text="Start" FontSize="12" />
                            <DatePicker x:Name="ExportStartDatePicker"
                                        SemanticProperties.Description="Start date for export metadata window"
                                        DateSelected="OnExportPreviewWindowChanged" />
                        </VerticalStackLayout>
                        <VerticalStackLayout>
                            <Label Text="End" FontSize="12" />
                            <DatePicker x:Name="ExportEndDatePicker"
                                        SemanticProperties.Description="End date for export metadata window"
                                        DateSelected="OnExportPreviewWindowChanged" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <Frame Style="{StaticResource CardFrameStyle}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Comparison Preview" Style="{StaticResource SectionTitleLabelStyle}" />
                    <Label x:Name="ComparisonPreviewNarrativeLabel" Text="Comparison narrative: not available yet." LineBreakMode="WordWrap" />
                    <Label x:Name="ComparisonPreviewNormalizationLabel" Text="Normalization: -" />
                    <CollectionView x:Name="ComparisonPreviewBadgesCollection"
                                    SelectionMode="None"
                                    HeightRequest="52">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame BorderColor="{Binding BorderColor}" BackgroundColor="{Binding BackgroundColor}" Padding="8,4" CornerRadius="10">
                                    <VerticalStackLayout Spacing="1">
                                        <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="11" />
                                        <Label Text="{Binding Value}" FontSize="11" />
                                    </VerticalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    <CollectionView x:Name="ComparisonPreviewTimelineCollection"
                                    SelectionMode="None"
                                    HeightRequest="150">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame BorderColor="#E9ECEF" BackgroundColor="#FAFAFA" Padding="8,6" Margin="0,0,0,6">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding SessionDateText}" FontAttributes="Bold" />
                                        <HorizontalStackLayout Spacing="10">
                                            <Label Text="{Binding AttemptsText}" FontSize="12" />
                                            <Label Text="{Binding OverallText}" FontSize="12" />
                                            <Label Text="{Binding ConfidenceText}" FontSize="12" />
                                        </HorizontalStackLayout>
                                        <Label Text="{Binding DeltaText}" FontSize="12" />
                                    </VerticalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Frame>

            <Frame Style="{StaticResource CardFrameStyle}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Assignment Analytics" Style="{StaticResource SectionTitleLabelStyle}" />
                    <Label x:Name="AssignmentAnalyticsSummaryLabel" Text="No assignment snapshots yet." />

                    <HorizontalStackLayout x:Name="AssignmentTargetRow" Spacing="8" VerticalOptions="Center">
                        <Label Text="Target drill-down" VerticalOptions="Center" />
                        <Picker x:Name="AssignmentTargetPicker"
                                SemanticProperties.Description="Select target sound for assignment analytics drill-down"
                                SelectedIndexChanged="OnAssignmentTargetChanged" />
                    </HorizontalStackLayout>

                    <CollectionView x:Name="AssignmentSnapshotCollection"
                                    SelectionMode="Single"
                                    SelectionChanged="OnAssignmentSnapshotSelectionChanged"
                                    HeightRequest="180">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame BorderColor="#E9ECEF" BackgroundColor="#FAFAFA" Padding="8,6" Margin="0,0,0,6">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding SnapshotDateText}" FontAttributes="Bold" FontSize="12" />
                                        <Label Text="{Binding FocusTargetsText}" FontSize="12" />
                                        <Label Text="{Binding DriftSummaryText}" FontSize="11" TextColor="#555555" />
                                    </VerticalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Label Text="Priority Component Trends (across snapshots)" FontAttributes="Bold" FontSize="12" />

                    <Grid x:Name="PrioritySparklineGrid" ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="8">
                        <Label Grid.Row="0" Grid.Column="0" Text="Severity" FontSize="12" VerticalOptions="Center" />
                        <CollectionView Grid.Row="0" Grid.Column="1"
                                        x:Name="SeveritySparklineCollection"
                                        SelectionMode="None"
                                        HeightRequest="30">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="3" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <BoxView WidthRequest="6"
                                             HeightRequest="{Binding Height}"
                                             VerticalOptions="End"
                                             Color="{Binding ColorHex}" />
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <Label Grid.Row="1" Grid.Column="0" Text="Instability" FontSize="12" VerticalOptions="Center" />
                        <CollectionView Grid.Row="1" Grid.Column="1"
                                        x:Name="InstabilitySparklineCollection"
                                        SelectionMode="None"
                                        HeightRequest="30">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="3" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <BoxView WidthRequest="6"
                                             HeightRequest="{Binding Height}"
                                             VerticalOptions="End"
                                             Color="{Binding ColorHex}" />
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <Label Grid.Row="2" Grid.Column="0" Text="Decline" FontSize="12" VerticalOptions="Center" />
                        <CollectionView Grid.Row="2" Grid.Column="1"
                                        x:Name="DeclineSparklineCollection"
                                        SelectionMode="None"
                                        HeightRequest="30">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="3" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <BoxView WidthRequest="6"
                                             HeightRequest="{Binding Height}"
                                             VerticalOptions="End"
                                             Color="{Binding ColorHex}" />
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <Label Grid.Row="3" Grid.Column="0" Text="Frequency" FontSize="12" VerticalOptions="Center" />
                        <CollectionView Grid.Row="3" Grid.Column="1"
                                        x:Name="FrequencySparklineCollection"
                                        SelectionMode="None"
                                        HeightRequest="30">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="3" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <BoxView WidthRequest="6"
                                             HeightRequest="{Binding Height}"
                                             VerticalOptions="End"
                                             Color="{Binding ColorHex}" />
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <Label Grid.Row="4" Grid.Column="0" Text="Confidence" FontSize="12" VerticalOptions="Center" />
                        <CollectionView Grid.Row="4" Grid.Column="1"
                                        x:Name="ConfidenceSparklineCollection"
                                        SelectionMode="None"
                                        HeightRequest="30">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="3" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <BoxView WidthRequest="6"
                                             HeightRequest="{Binding Height}"
                                             VerticalOptions="End"
                                             Color="{Binding ColorHex}" />
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Grid>

                    <Label x:Name="SeverityTrendChartLabel" Text="Severity trend: -" FontSize="11" TextColor="#555555" />
                    <Label x:Name="InstabilityTrendChartLabel" Text="Instability trend: -" FontSize="11" TextColor="#555555" />
                    <Label x:Name="DeclineTrendChartLabel" Text="Decline trend: -" FontSize="11" TextColor="#555555" />
                    <Label x:Name="FrequencyTrendChartLabel" Text="Frequency trend: -" FontSize="11" TextColor="#555555" />
                    <Label x:Name="ConfidenceTrendChartLabel" Text="Confidence trend: -" FontSize="11" TextColor="#555555" />

                    <Label Text="Longitudinal Model Audit" FontAttributes="Bold" FontSize="12" Margin="0,10,0,0" />
                    <Label x:Name="AssignmentModelAuditSummaryLabel" Text="No assignment model-audit snapshots available." FontSize="11" />
                    <Label x:Name="AssignmentFormulaVersionSummaryLabel" Text="Formula versions: n/a" FontSize="11" TextColor="#555555" />
                    <Label x:Name="AssignmentAdvisoryWeightLabel" Text="No advisory weight suggestion available yet." FontSize="11" TextColor="#555555" />

                    <Grid x:Name="ModelAuditSparklineGrid" ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="8">
                        <Label Grid.Row="0" Grid.Column="0" Text="Calib next-1" FontSize="12" VerticalOptions="Center" />
                        <CollectionView Grid.Row="0" Grid.Column="1"
                                        x:Name="CalibrationNext1SparklineCollection"
                                        SelectionMode="None"
                                        HeightRequest="28">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="3" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <BoxView WidthRequest="6" HeightRequest="{Binding Height}" VerticalOptions="End" Color="{Binding ColorHex}" />
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <Label Grid.Row="1" Grid.Column="0" Text="Calib next-3" FontSize="12" VerticalOptions="Center" />
                        <CollectionView Grid.Row="1" Grid.Column="1"
                                        x:Name="CalibrationNext3SparklineCollection"
                                        SelectionMode="None"
                                        HeightRequest="28">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="3" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <BoxView WidthRequest="6" HeightRequest="{Binding Height}" VerticalOptions="End" Color="{Binding ColorHex}" />
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <Label Grid.Row="2" Grid.Column="0" Text="Trace drift" FontSize="12" VerticalOptions="Center" />
                        <CollectionView Grid.Row="2" Grid.Column="1"
                                        x:Name="TraceDriftSparklineCollection"
                                        SelectionMode="None"
                                        HeightRequest="28">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="3" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <BoxView WidthRequest="6" HeightRequest="{Binding Height}" VerticalOptions="End" Color="{Binding ColorHex}" />
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Grid>

                    <CollectionView x:Name="AssignmentModelAuditCollection"
                                    SelectionMode="None"
                                    HeightRequest="180">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame BorderColor="#E9ECEF" BackgroundColor="#F8FAFC" Padding="8,6" Margin="0,0,0,6">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding SnapshotDateText}" FontAttributes="Bold" FontSize="12" />
                                        <Label Text="{Binding FormulaVersionText}" FontSize="11" TextColor="#555555" />
                                        <HorizontalStackLayout Spacing="10">
                                            <Label Text="{Binding Next1MaeText}" FontSize="11" />
                                            <Label Text="{Binding Next3MaeText}" FontSize="11" />
                                        </HorizontalStackLayout>
                                        <Label Text="{Binding TraceDriftText}" FontSize="11" />
                                    </VerticalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Frame>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button Grid.Column="0"
                    Text="Export Latest Report"
                        SemanticProperties.Description="Export latest report using selected format and metadata window"
                    Clicked="OnExportLatestClicked" />
                <Button Grid.Column="1"
                    Text="Share Latest Report"
                        SemanticProperties.Description="Share latest report or export only based on settings"
                    Clicked="OnShareLatestClicked" />
                </Grid>

            <Label x:Name="NoteStatusLabel" Text="" FontAttributes="Italic" />

            <Frame Style="{StaticResource CardFrameStyle}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Clinician SOAP Summary" Style="{StaticResource SectionTitleLabelStyle}" />
                    <Label x:Name="SoapSummaryLabel" Text="No summary generated yet." />
                </VerticalStackLayout>
            </Frame>

            <Frame Style="{StaticResource CardFrameStyle}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Parent-Friendly Summary" Style="{StaticResource SectionTitleLabelStyle}" />
                    <Label x:Name="ParentSummaryLabel" Text="No summary generated yet." />
                </VerticalStackLayout>
            </Frame>

            <Label Text="Note History" Style="{StaticResource SectionTitleLabelStyle}" />

            <CollectionView x:Name="NotesHistoryCollection"
                            SelectionMode="Single"
                            SelectionChanged="OnHistorySelectionChanged">
                <CollectionView.EmptyView>
                    <Label Text="No saved notes yet." />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Margin="0,0,0,8" Style="{StaticResource CardFrameStyle}">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding SessionDate, StringFormat='{0:yyyy-MM-dd HH:mm}'}"
                                       FontAttributes="Bold" />
                                <Label Text="{Binding SoapSummary}" />
                                <Label Text="{Binding ParentSummary}" TextColor="#555555" />
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
