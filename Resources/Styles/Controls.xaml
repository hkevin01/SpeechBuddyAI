<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <x:Double x:Key="Spacing4">4</x:Double>
    <x:Double x:Key="Spacing8">8</x:Double>
    <x:Double x:Key="Spacing12">12</x:Double>
    <x:Double x:Key="Spacing16">16</x:Double>
    <x:Double x:Key="Spacing24">24</x:Double>
    <x:Double x:Key="TouchTargetMin">48</x:Double>

    <Style x:Key="PageRootLayoutStyle" TargetType="VerticalStackLayout">
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="Spacing" Value="12" />
    </Style>

    <Style x:Key="PageTitleLabelStyle" TargetType="Label">
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource OnBackground}" />
        <Setter Property="FontSize" Value="{OnIdiom Phone=24, Tablet=28, Desktop=24}" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
    </Style>

    <Style x:Key="SectionTitleLabelStyle" TargetType="Label">
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource OnBackground}" />
        <Setter Property="FontSize" Value="{OnIdiom Phone=16, Tablet=18, Desktop=16}" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
    </Style>

    <Style x:Key="CaptionLabelStyle" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource MutedText}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource OnBackground}" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
        <Setter Property="FontSize" Value="{OnIdiom Phone=14, Tablet=16, Desktop=14}" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
        <Setter Property="TextColor" Value="{StaticResource OnPrimary}" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource TouchTargetMin}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="Margin" Value="0,4,0,4" />
    </Style>

    <Style TargetType="Entry">
        <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
        <Setter Property="TextColor" Value="{StaticResource OnBackground}" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource TouchTargetMin}" />
        <Setter Property="Margin" Value="0,4,0,4" />
    </Style>

    <Style TargetType="Editor">
        <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
        <Setter Property="TextColor" Value="{StaticResource OnBackground}" />
        <Setter Property="Margin" Value="0,4,0,4" />
    </Style>

    <Style TargetType="Picker">
        <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
        <Setter Property="TextColor" Value="{StaticResource OnBackground}" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource TouchTargetMin}" />
        <Setter Property="Margin" Value="0,4,0,4" />
    </Style>

    <Style x:Key="CardFrameStyle" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
        <Setter Property="BorderColor" Value="{StaticResource Outline}" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="HasShadow" Value="True" />
        <Setter Property="Margin" Value="0,4,0,4" />
    </Style>
</ResourceDictionary>
