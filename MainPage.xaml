<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SpeechBuddyAI.MainPage"
             Title="SpeechBuddy AI">
    <ScrollView>
        <VerticalStackLayout Style="{StaticResource PageRootLayoutStyle}">
            <Label Text="SpeechBuddy AI" Style="{StaticResource PageTitleLabelStyle}" />
            <Label Text="A therapist companion app for articulation, practice planning, progress tracking, and session notes." />
                <Button Text="Open Practice"
                        TabIndex="0"
                    SemanticProperties.Description="Open the Practice tab to score attempts"
                    Clicked="OnPracticeClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
